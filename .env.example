# ====================================================
# KalaKriti Art Studio — Environment Configuration Example
# ====================================================

# Backend Configuration (server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/artstudio
JWT_SECRET=super_secret_art_studio_jwt_token_key_change_in_production_2026
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials (Local Demo Access)
ADMIN_NAME=Studio Administrator
ADMIN_EMAIL=studio@artstudio.in
ADMIN_PASSWORD=Studio@123

# Dedicated Jury Demo Administrator (Local Evaluation)
DEMO_ADMIN_NAME=Administrator 1
DEMO_ADMIN_EMAIL=demo.admin@kalakriti.in
DEMO_ADMIN_PASSWORD=KalaDemo@123

# Cloud Image Storage (Optional: Cloudinary for cloud persistent uploads; falls back to server/uploads/paintings/ if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration (client/.env)
VITE_API_URL=/api
